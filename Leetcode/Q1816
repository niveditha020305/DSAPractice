class Solution {
    public String truncateSentence(String s, int k) {
        StringBuilder sb=new StringBuilder();
        int spaces=0;

        for(int i=0;i<s.length();i++){
            if(s.charAt(i)==' '){
                spaces++;
                if(spaces>=k){
                    break;                    }
                sb.append(" ");
            }                
            else{
                sb.append(s.charAt(i));
            }
        }
        return sb.toString();
    }
}
