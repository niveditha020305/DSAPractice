class Solution {
    public int gcdOfOddEvenSums(int n) {
        int sumOdd=0;
        int sumEven=0;

        for(int i=0;i<=n*2;i++){
            if(i%2==0){
                sumEven+=i;
            }
            else{
                sumOdd+=i;
            }
        }
        return gcd(sumOdd,sumEven);
    }
     public int gcd(int n1,int n2){
        if(n2==0){
            return n1;
        }

        return gcd(n2,n1%n2);
    
    }
}


class Solution {
    public int gcdOfOddEvenSums(int n) {
        int sumOdd=n*n;
        int sumEven=n*(n+1);

        return gcd(sumOdd,sumEven);
    }

    public int gcd(int n1,int n2){
        if(n2==0){
            return n1;
        }
        return gcd(n2,n1%n2);
    }
}
