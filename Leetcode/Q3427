class Solution {
    public int subarraySum(int[] nums) {
        int totalSum=0;

        for(int i=0;i<nums.length;i++){
            int sum=0;
            for(int j=Math.max(0,i-nums[i]);j<i;j++){
                sum=sum+nums[j];
            }
            totalSum=totalSum+sum;
        }

        return totalSum;
    }
}
