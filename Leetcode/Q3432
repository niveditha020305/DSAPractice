class Solution {
    public int countPartitions(int[] nums) {
        int partitions=0;
        int totalSum=0;
        int rightSum=0;
        int leftSum=0;

        for(int i=0;i<nums.length;i++){
            totalSum+=nums[i];
        }

        for(int i=1;i<nums.length;i++){
            rightSum+=nums[i];
            leftSum=totalSum-rightSum;
            int difference=leftSum-rightSum;

            if(difference%2==0){
                partitions++;
            }
        }

        return partitions;
    }
}
