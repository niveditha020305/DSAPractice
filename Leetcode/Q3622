class Solution {
    public boolean checkDivisibility(int n) {
        int original=n;
        int sum=0;
        int digitSum=0;
        int digitProduct=1;

        while(n>0){
            int digit=n%10;
            n=n/10;
            digitSum+=digit;
            digitProduct*=digit;

        }

        sum=digitSum+digitProduct;

        if(original%sum==0){
            return true;
        }

        else{
            return false;
        }
    }
}
