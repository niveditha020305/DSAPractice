class Solution {
    public boolean divideArray(int[] nums) {
        HashMap<Integer,Integer> map=new HashMap<>();

        if((nums.length)%2!=0){
            return false;
        }

        for(int num:nums){
            map.put(num,map.getOrDefault(num,0)+1);
        } 

        boolean found=true;

        for(Integer value:map.values()){
            if(value%2==0){
                found=true;
            }
            else{
                return false;
            }
        }

        return found;
    }
}

class Solution {
    public boolean divideArray(int[] nums) {
        int[] freq=new int[501];

        if((nums.length%2)!=0){
            return false;
        }

        for(int i=0;i<nums.length;i++){
            freq[nums[i]]++;
        }

        boolean ans=true;

        for(int i=0;i<freq.length;i++){
            if((freq[i]%2)==0){
                ans=true;
            }

            else{
                return false;
            }
        }

        return ans;
    }
}
